{
  "name": "kalkylator-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:wasm && tsc --noEmit && vite build",
    "build:wasm": "wasm-pack build ../../crates/calculator-core --target web --out-dir ../../apps/web/src/generated/wasm --out-name calculator_core",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "tauri": "tauri",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "ts-jest": "^29.4.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "@playwright/test": "^1.56.1"
  }
}
