{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kalkylator",
  "version": "0.1.0",
  "identifier": "se.example.kalkylator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kalkylator",
        "width": 600,
        "height": 750,
        "minWidth": 380,
        "minHeight": 580
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.png"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
